# Aurora sensor agent environment (installed to /etc/aurora-sensor-agent/agent.env).
# The demo unit runs the simulator; a real device sets its identity and backend here and the
# operator points ExecStart at the real sensor/transport wiring.

# Device identity (issued during provisioning).
AURORA_DEVICE_ID=replace-with-device-uuid
AURORA_CLINIC_ID=replace-with-clinic-uuid

# Backend uplink (MQTT primary, HTTP fallback).
AURORA_MQTT_BROKER_HOST=mqtt.example.internal
AURORA_MQTT_BROKER_PORT=1883
AURORA_API_BASE_URL=https://api.example.internal

# Sampling.
AURORA_SAMPLE_INTERVAL_SECONDS=30
